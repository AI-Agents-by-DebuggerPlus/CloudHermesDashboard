<Window x:Class="CloudHermesDashboard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CloudHermesDashboard.Views"
        Title="Cloud Hermes"
        Width="1320"
        Height="860"
        MinWidth="1100"
        MinHeight="680"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="272"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Style="{StaticResource PanelStyle}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="6,0,6,12">
                    <TextBlock Style="{StaticResource PanelTitle}" Text="Agents"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Tasks"
                                Command="{Binding OpenTasksCommand}"
                                Style="{StaticResource QuietButton}"/>
                        <Button Margin="4,0,8,0"
                                Content="Logs"
                                Command="{Binding OpenLogsCommand}"
                                Style="{StaticResource QuietButton}"/>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Text="{Binding AgentCount, StringFormat={}{0} agents}"/>
                    </StackPanel>
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           Margin="6,0,6,8"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding RosterMessage}"
                           TextWrapping="Wrap"/>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Agents}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AgentCardButton}"
                                        Command="{Binding DataContext.SelectAgentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Border Padding="14" CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                                        <Setter Property="BorderBrush" Value="#3D4C63"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CardSelectedBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="{Binding AccentBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{Binding AccentBrush}"
                                                               Text="{Binding RoleLabel}"/>
                                                </Border>
                                            </Grid>
                                            <views:StatusIndicator Margin="0,12,0,0"/>
                                            <TextBlock Margin="0,12,0,0"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding CurrentTask}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding CurrentTask}"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Style="{StaticResource PanelStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,12"
                           Style="{StaticResource PanelTitle}"
                           Text="Details"/>

                <Grid>
                    <Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,8,0">
                            <TextBlock Margin="0,0,0,12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Select an agent to see its task."
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedAgent}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel DataContext="{Binding SelectedAgent}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedAgent, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Name}"/>
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <Border Padding="8,3"
                                            VerticalAlignment="Center"
                                            BorderBrush="{Binding AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <TextBlock FontSize="11"
                                                   Foreground="{Binding AccentBrush}"
                                                   Text="{Binding RoleLabel}"/>
                                    </Border>
                                    <views:StatusIndicator Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Margin="0,18,0,0" Style="{StaticResource CaptionText}" Text="MODEL"/>
                                <TextBlock FontFamily="Consolas"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding Model}"
                                           TextWrapping="Wrap"/>

                                <Border Height="1" Margin="0,16" Background="{StaticResource LineBrush}"/>

                                <TextBlock Style="{StaticResource CaptionText}" Text="CURRENT TASK"/>
                                <TextBlock LineHeight="20" Text="{Binding CurrentTask}" TextWrapping="Wrap"/>

                                <TextBlock Margin="0,14,0,0" Style="{StaticResource CaptionText}" Text="FIXED AT SPAWN"/>
                                <TextBlock Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding ToolsetsAtSpawn}"
                                           TextWrapping="Wrap"/>

                                <Border Height="1" Margin="0,16" Background="{StaticResource LineBrush}"/>

                                <TextBlock Style="{StaticResource CaptionText}" Text="RECENT ACTIVITY"/>
                                <ItemsControl ItemsSource="{Binding RecentEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,2,0,0"
                                                           VerticalAlignment="Top"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Text="{Binding TimeLabel}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{Binding TypeBrush}"
                                                               Text="{Binding TypeLabel}"/>
                                                    <TextBlock Margin="0,3,0,0"
                                                               Text="{Binding Text}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <views:PermissionsPanel Margin="0,8,0,0" DataContext="{Binding Permissions}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" Style="{StaticResource PanelStyle}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,0,4,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="#3FB950"/>
                        <TextBlock Style="{StaticResource PanelTitle}" Text="Event log"/>
                    </StackPanel>
                    <ComboBox Width="200"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding Filters}"
                              SelectedItem="{Binding SelectedFilter}"
                              Style="{StaticResource DarkComboBox}"/>
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="8,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColumnHeaderText}" Text="TIME"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderText}" Text="AGENT"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderText}" Text="TYPE"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderText}" Text="TEXT"/>
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredEvents}" AlternationCount="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,7" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1">
                                                    <Setter Property="Background" Value="{StaticResource RowAltBrush}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="128"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding TimeLabel}"/>
                                        <Border Grid.Column="1"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="#141A24"
                                                BorderBrush="{Binding AccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding AccentBrush}"
                                                       Text="{Binding AgentName}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="{Binding TypeBrush}"
                                                   Text="{Binding TypeLabel}"/>
                                        <TextBlock Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Text}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
