<Window x:Class="CloudHermesDashboard.Views.TaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task manager"
        Width="760"
        Height="520"
        MinWidth="560"
        MinHeight="360"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Border Margin="16" Style="{StaticResource PanelStyle}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        Style="{StaticResource QuietButton}"/>
                <TextBlock Style="{StaticResource PanelTitle}" Text="Tasks"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,10"
                       Foreground="{StaticResource MutedBrush}"
                       Text="{Binding Banner}"
                       TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding Status}"/>
                                    <TextBlock Grid.Column="2"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding Priority}"/>
                                    <TextBlock Grid.Column="3"
                                               HorizontalAlignment="Right"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding CreatedLabel}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
