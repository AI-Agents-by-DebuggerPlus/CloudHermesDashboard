<Window x:Class="CloudHermesDashboard.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes logs"
        Width="860"
        Height="520"
        MinWidth="640"
        MinHeight="360"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Border Margin="16" Style="{StaticResource PanelStyle}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Command="{Binding ClearCommand}"
                        Content="Clear"
                        Style="{StaticResource QuietButton}"/>
                <TextBlock Style="{StaticResource PanelTitle}" Text="Logs"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,8"
                       Foreground="{StaticResource MutedBrush}"
                       FontFamily="Consolas"
                       FontSize="11"
                       Text="{Binding LogFilePath}"
                       TextTrimming="CharacterEllipsis"/>
            <ScrollViewer x:Name="LogScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="LogScroll_OnScrollChanged">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,0,0,4"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Text="{Binding Line}"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
